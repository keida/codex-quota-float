<Window x:Class="QuotaFloat.Wpf.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quota Float Settings"
        Width="520"
        Height="520"
        MinWidth="520"
        MinHeight="520"
        MaxWidth="520"
        MaxHeight="520"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        AutomationProperties.AutomationId="SettingsWindow"
        AutomationProperties.Name="偏好设置">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#101C31" />
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#E2AD3D" />
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF8E8" />
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#B5C0CF" />
        <SolidColorBrush x:Key="SettingsLineBrush" Color="#40506B" />
        <SolidColorBrush x:Key="SettingsSyncBrush" Color="#35BCA4" />

        <Style x:Key="SettingsLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsNoteStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="9" />
        </Style>
        <Style x:Key="SettingsOutlineButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="#15233C" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="SettingsPrimaryButtonStyle" BasedOn="{StaticResource SettingsOutlineButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource SettingsAccentBrush}" />
            <Setter Property="Foreground" Value="#101C31" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
        </Style>
        <Style x:Key="SettingsSegmentStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#101C31" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource SettingsAccentBrush}" />
                                <Setter Property="Foreground" Value="#101C31" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#40506B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border x:Name="SwitchTrack" Background="{TemplateBinding Background}" CornerRadius="8" />
                            <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Fill="#FFF8E8" HorizontalAlignment="Left" Margin="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource SettingsAccentBrush}" />
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="#101C31" />
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchKnob" Property="Margin" Value="0,2,2,2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource SettingsTextBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SettingsSurfaceBrush}"
            BorderBrush="{StaticResource SettingsAccentBrush}"
            BorderThickness="2"
            AutomationProperties.AutomationId="SettingsSurface">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="405" />
                <RowDefinition Height="51" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#15233C" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,0,0,1" Padding="16,8,16,7">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="偏好设置" Foreground="{StaticResource SettingsTextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="19" FontWeight="Bold" />
                        <TextBlock x:Name="SubtitleText" Text="本地保存 · 修改即时生效" Style="{StaticResource SettingsNoteStyle}" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SavedStateText" Text="已保存 · 刚刚" Foreground="{StaticResource SettingsSyncBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,17,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,0,1,0" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="ViewLabelText" Text="默认窗口" Style="{StaticResource SettingsLabelStyle}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="FullViewButton" Grid.Column="0" TabIndex="1" Content="Full" Style="{StaticResource SettingsSegmentStyle}" AutomationProperties.AutomationId="SettingsDefaultFull" Checked="DefaultFull_OnClick" />
                        <ToggleButton x:Name="OrbViewButton" Grid.Column="1" TabIndex="2" Content="Orb" Style="{StaticResource SettingsSegmentStyle}" AutomationProperties.AutomationId="SettingsDefaultOrb" Checked="DefaultOrb_OnClick" />
                    </Grid>

                    <TextBlock x:Name="LanguageLabelText" Text="语言" Style="{StaticResource SettingsLabelStyle}" Margin="0,15,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ChineseLanguageButton" Grid.Column="0" TabIndex="3" Content="简体中文" Style="{StaticResource SettingsSegmentStyle}" AutomationProperties.AutomationId="SettingsLanguageChinese" Checked="ChineseLanguage_OnClick" />
                        <ToggleButton x:Name="EnglishLanguageButton" Grid.Column="1" TabIndex="4" Content="English" Style="{StaticResource SettingsSegmentStyle}" AutomationProperties.AutomationId="SettingsLanguageEnglish" Checked="EnglishLanguage_OnClick" />
                    </Grid>

                    <Grid Margin="0,15,0,0">
                        <TextBlock x:Name="FullSizeLabelText" Text="Full 大小" Style="{StaticResource SettingsLabelStyle}" />
                        <TextBlock x:Name="FullSizeValueText" Text="100%" Foreground="{StaticResource SettingsTextBrush}" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="FullSizeSlider" TabIndex="5" Minimum="40" Maximum="100" TickFrequency="30" IsSnapToTickEnabled="True" Value="100" Height="24" Margin="0,3,0,0" Foreground="{StaticResource SettingsAccentBrush}" AutomationProperties.AutomationId="SettingsFullSizeSlider" ValueChanged="FullSizeSlider_OnValueChanged">
                        <Slider.Template>
                            <ControlTemplate TargetType="{x:Type Slider}">
                                <Grid>
                                    <Track x:Name="PART_Track" Height="12" VerticalAlignment="Center">
                                        <Track.RenderTransform>
                                            <TranslateTransform Y="2" />
                                        </Track.RenderTransform>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Height="4" VerticalAlignment="Center" Background="{StaticResource SettingsAccentBrush}" BorderThickness="0" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="{TemplateBinding Background}" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Height="4" VerticalAlignment="Center" Background="#3A4961" BorderThickness="0" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="{TemplateBinding Background}" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="12" Height="12" Background="{StaticResource SettingsAccentBrush}">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Ellipse Fill="{TemplateBinding Background}" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                    <Grid>
                        <TextBlock x:Name="MinSizeText" Text="40%" Style="{StaticResource SettingsNoteStyle}" />
                        <TextBlock x:Name="MaxSizeText" Text="100%" Style="{StaticResource SettingsNoteStyle}" HorizontalAlignment="Right" />
                    </Grid>
                        <Button x:Name="RestoreFullSizeButton" TabIndex="6" Content="恢复 100%" Style="{StaticResource SettingsOutlineButtonStyle}" Height="27" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="5,0" AutomationProperties.AutomationId="SettingsRestoreFullSize" Click="RestoreFullSize_OnClick">
                            <Button.RenderTransform>
                                <TranslateTransform Y="-3" />
                            </Button.RenderTransform>
                        </Button>

                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" Margin="0,11,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AppearanceLabelText" Text="Windows 外观" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBlock x:Name="AppearanceNoteText" Text="使用系统 DPI、字体与高对比度；不提供独立主题选择器。" Style="{StaticResource SettingsNoteStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Grid Height="38">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AlwaysTopLabelText" Text="始终置顶" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBlock x:Name="AlwaysTopNoteText" Text="默认开启" Style="{StaticResource SettingsNoteStyle}" />
                        </StackPanel>
                        <ToggleButton x:Name="AlwaysTopToggle" TabIndex="7" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.AutomationId="SettingsAlwaysOnTop" Checked="AlwaysTop_OnClick" Unchecked="AlwaysTop_OnClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                    <Grid Height="38">
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="EdgeAutoOrbLabelText" Text="贴边变悬浮球" Style="{StaticResource SettingsLabelStyle}" /><TextBlock x:Name="EdgeAutoOrbNoteText" Text="24 px 触发" Style="{StaticResource SettingsNoteStyle}" /></StackPanel>
                        <ToggleButton x:Name="EdgeAutoOrbToggle" TabIndex="8" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.AutomationId="SettingsEdgeAutoOrb" Checked="EdgeAutoOrb_OnClick" Unchecked="EdgeAutoOrb_OnClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                    <Grid Height="38">
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="HoverExpandLabelText" Text="悬停展开 Full" Style="{StaticResource SettingsLabelStyle}" /><TextBlock x:Name="HoverExpandNoteText" Text="300 ms" Style="{StaticResource SettingsNoteStyle}" /></StackPanel>
                        <ToggleButton x:Name="HoverExpandToggle" TabIndex="9" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.AutomationId="SettingsHoverExpandFull" Checked="HoverExpand_OnClick" Unchecked="HoverExpand_OnClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                    <Grid Height="38">
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ClickThroughLabelText" Text="鼠标穿透" Style="{StaticResource SettingsLabelStyle}" /><TextBlock x:Name="ClickThroughNoteText" Text="重启自动关闭" Style="{StaticResource SettingsNoteStyle}" /></StackPanel>
                        <ToggleButton x:Name="ClickThroughToggle" TabIndex="10" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.AutomationId="SettingsMouseClickThrough" Checked="ClickThrough_OnClick" Unchecked="ClickThrough_OnClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                    <Grid Height="38">
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="AutoRefreshLabelText" Text="自动刷新" Style="{StaticResource SettingsLabelStyle}" /><TextBlock x:Name="AutoRefreshNoteText" Text="失败时退避" Style="{StaticResource SettingsNoteStyle}" /></StackPanel>
                        <ToggleButton x:Name="AutoRefreshToggle" TabIndex="11" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.AutomationId="SettingsAutoRefresh" Checked="AutoRefresh_OnClick" Unchecked="AutoRefresh_OnClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                    <Grid Height="38">
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="FollowLifecycleLabelText" Text="跟随 Codex 生命周期" Style="{StaticResource SettingsLabelStyle}" /><TextBlock x:Name="FollowLifecycleNoteText" Text="Codex 全部关闭后退出" Style="{StaticResource SettingsNoteStyle}" /></StackPanel>
                        <ToggleButton x:Name="FollowLifecycleToggle" TabIndex="12" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.AutomationId="SettingsFollowCodexLifecycle" Checked="FollowLifecycle_OnClick" Unchecked="FollowLifecycle_OnClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                    <Grid Height="38">
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="LowQuotaLabelText" Text="低额度提醒" Style="{StaticResource SettingsLabelStyle}" /><TextBlock x:Name="LowQuotaNoteText" Text="阈值在高级设置" Style="{StaticResource SettingsNoteStyle}" /></StackPanel>
                        <ToggleButton x:Name="LowQuotaToggle" TabIndex="13" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.AutomationId="SettingsLowQuotaAlerts" Checked="LowQuota_OnClick" Unchecked="LowQuota_OnClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" />
                    <Grid Height="55">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="RefreshIntervalLabelText" Text="刷新间隔" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Center" />
                        <Grid x:Name="RefreshIntervalHost" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="230">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="RefreshIntervalInput" TabIndex="14" Width="174" Height="28" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Left" Background="#101C31" BorderBrush="{StaticResource SettingsLineBrush}" Foreground="{StaticResource SettingsTextBrush}" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" AutomationProperties.AutomationId="SettingsRefreshInterval" TextChanged="RefreshInterval_OnTextChanged" />
                            <TextBlock Grid.Column="1" x:Name="RefreshSecondsText" Text="秒" Foreground="{StaticResource SettingsTextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,5,0" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#15233C" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" Padding="14,8,14,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HelpButton" TabIndex="15" Width="40" MinWidth="0" Padding="0" Content="帮助" Style="{StaticResource SettingsOutlineButtonStyle}" AutomationProperties.AutomationId="SettingsHelp" Click="Help_OnClick" />
                        <Button x:Name="ResetButton" TabIndex="16" Width="58" Padding="0" Content="重置偏好" Style="{StaticResource SettingsOutlineButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="SettingsResetPreferences" Click="Reset_OnClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterSavedText" Text="已保存 · 刚刚" Foreground="{StaticResource SettingsSyncBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="DoneButton" TabIndex="17" Content="完成" Style="{StaticResource SettingsPrimaryButtonStyle}" Width="70" AutomationProperties.AutomationId="SettingsDone" Click="Done_OnClick" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
