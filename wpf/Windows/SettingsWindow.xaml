<Window x:Class="QuotaFloat.Wpf.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quota Float Preferences"
        Width="420"
        Height="296"
        MinWidth="420"
        MinHeight="296"
        MaxWidth="420"
        MaxHeight="296"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#101C31"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="SettingsWindow"
        AutomationProperties.Name="Preferences">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#101C31" />
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#E2AD3D" />
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF8E8" />
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#B5C0CF" />
        <SolidColorBrush x:Key="SettingsLineBrush" Color="#40506B" />
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SettingsNoteStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="Background" Value="#15233C" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingsChoiceStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}" />
            <Setter Property="Background" Value="#101C31" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource SettingsAccentBrush}" />
                                <Setter Property="Foreground" Value="#101C31" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="SettingsContentGrid" Background="#101C31">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="184" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderSurface" Grid.Row="0" Background="#15233C" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,0,0,1" Padding="16,8" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="偏好设置" Style="{StaticResource SettingsLabelStyle}" FontSize="19" />
                        <TextBlock x:Name="SubtitleText" Text="拖动此标题栏可移动窗口" Style="{StaticResource SettingsNoteStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SavedStateText" Text="已保存" Style="{StaticResource SettingsNoteStyle}" Foreground="{StaticResource SettingsAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="15" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabelText" Text="语言" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock x:Name="LanguageSupportText" Text="切换后立即生效" Style="{StaticResource SettingsNoteStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <RadioButton x:Name="ChineseLanguageButton" Grid.Column="0" GroupName="Language" Content="简体中文" Style="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="SettingsLanguageChinese" Checked="ChineseLanguage_OnClick" />
                        <RadioButton x:Name="EnglishLanguageButton" Grid.Column="1" GroupName="Language" Content="English" Style="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="SettingsLanguageEnglish" Checked="EnglishLanguage_OnClick" />
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="RefreshIntervalLabelText" Text="刷新间隔" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock x:Name="AutoRefreshNoteText" Text="自动刷新始终开启" Style="{StaticResource SettingsNoteStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AutomationId="SettingsRefreshInterval">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="Refresh15Button" Grid.Column="0" GroupName="RefreshInterval" Content="15s" Tag="15" Style="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="SettingsRefresh15s" Checked="RefreshInterval_OnChecked" />
                        <RadioButton x:Name="Refresh30Button" Grid.Column="1" GroupName="RefreshInterval" Content="30s" Tag="30" Style="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="SettingsRefresh30s" Checked="RefreshInterval_OnChecked" />
                        <RadioButton x:Name="Refresh60Button" Grid.Column="2" GroupName="RefreshInterval" Content="60s" Tag="60" Style="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="SettingsRefresh60s" Checked="RefreshInterval_OnChecked" />
                        <RadioButton x:Name="Refresh2mButton" Grid.Column="3" GroupName="RefreshInterval" Content="2m" Tag="120" Style="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="SettingsRefresh2m" Checked="RefreshInterval_OnChecked" />
                        <RadioButton x:Name="Refresh5mButton" Grid.Column="4" GroupName="RefreshInterval" Content="5m" Tag="300" Style="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="SettingsRefresh5m" Checked="RefreshInterval_OnChecked" />
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#15233C" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <TextBlock x:Name="FooterSavedText" Text="更改保存在本机" Style="{StaticResource SettingsNoteStyle}" VerticalAlignment="Center" />
                    <Button x:Name="DoneButton" Content="完成" Width="76" Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Right" AutomationProperties.AutomationId="SettingsDone" Click="Done_OnClick" IsDefault="True" />
                </Grid>
            </Border>
        </Grid>
</Window>
